# Authentik Environment Variables  
# Copy this file to .env and customize the values

# Database configuration
PG_PASS=your_secure_database_password_here
PG_USER=authentik
PG_DB=authentik

# Authentik configuration  
AUTHENTIK_SECRET_KEY=your_50_character_secret_key_here
AUTHENTIK_IMAGE=ghcr.io/goauthentik/server
AUTHENTIK_TAG=latest

# Domain configuration
TRAEFIK_DOMAIN=yourdomain.com
TRAEFIK_LOCAL_DOMAIN=local.yourdomain.com

# Email configuration (optional)
AUTHENTIK_EMAIL__HOST=smtp.gmail.com
AUTHENTIK_EMAIL__PORT=587
AUTHENTIK_EMAIL__USERNAME=your_email@gmail.com
AUTHENTIK_EMAIL__PASSWORD=your_app_password_here
AUTHENTIK_EMAIL__USE_TLS=true
AUTHENTIK_EMAIL__FROM=noreply@yourdomain.com

# Security settings
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_LOG_LEVEL=info

# System configuration
TZ=America/New_York