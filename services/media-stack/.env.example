# Media Stack Environment Variables
# Copy this file to .env and customize the values

# VPN Configuration (for download clients)
WIREGUARD_PUBLIC_KEY=your_wireguard_public_key_here
WIREGUARD_PRIVATE_KEY=your_wireguard_private_key_here
WIREGUARD_PRESHARED_KEY=your_wireguard_preshared_key_here

# Media paths (customize to your setup)
MEDIA_PATH=/path/to/your/media
DOWNLOADS_PATH=/path/to/your/downloads
CONFIG_PATH=/path/to/your/config

# Download client passwords
WEBUI_PASSWORD=your_secure_webui_password_here

# Plex configuration
PLEX_CLAIM=your_plex_claim_token_here
PLEX_UID=1000
PLEX_GID=1000

# Timezone
TZ=America/New_York

# Network configuration
SUBNET=10.8.1.0/24