# Traefik Environment Variables
# Copy this file to .env and customize the values

# Domain configuration
TRAEFIK_DOMAIN=yourdomain.com
TRAEFIK_LOCAL_DOMAIN=local.yourdomain.com

# Dashboard authentication (generate with: htpasswd -nb username password)
TRAEFIK_DASHBOARD_CREDENTIALS=admin:$2y$10$encrypted_password_here

# CrowdSec bouncer API key (generate in CrowdSec dashboard)
CROWDSEC_BOUNCER_API_KEY=your_crowdsec_bouncer_api_key_here

# System configuration
TZ=America/New_York
GID=1000

# Security settings
TRUSTED_IPS=10.0.0.0/24,192.168.1.0/24