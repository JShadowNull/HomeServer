#!/bin/bash

# Pre-commit hook to validate README.md consistency
# This ensures README stays in sync with actual repository structure

set -euo pipefail

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}Running pre-commit README validation...${NC}"

# Run README validation
if ./scripts/system/validate-readme.sh --validate; then
    echo -e "${GREEN}✓ README validation passed${NC}"
else
    echo -e "${RED}✗ README validation failed!${NC}"
    echo ""
    echo -e "${YELLOW}README is out of sync with repository structure.${NC}"
    echo -e "${YELLOW}Run: ./scripts/system/validate-readme.sh --update${NC}"
    echo ""
    echo -e "${RED}Commit blocked to prevent inconsistent documentation.${NC}"
    exit 1
fi

echo -e "${GREEN}Pre-commit validation complete.${NC}"